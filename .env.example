# ==============================================================================
# OUR BOUND — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env.local`:
#    cp .env.example .env.local
# 2. Fill in the values below.
# 3. NEVER commit `.env.local` to git or public repositories.
# ==============================================================================

# ── MONGODB ATLAS CONFIGURATION (REQUIRED FOR CLOUD PHOTO GALLERY) ──────────
# 1. Create a free cluster at https://www.mongodb.com/cloud/atlas
# 2. Go to Database → Connect → Connect your application
# 3. Copy the connection string (replace <password> with your database password)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=our-bound

# ── CLOUDINARY CONFIGURATION (REQUIRED FOR PHOTO STORAGE) ───────────────────
# 1. Create a free account at https://cloudinary.com
# 2. Go to Dashboard → Account Details
# 3. Copy the following values:
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── ADMIN PANEL SECURITY (CLIENT GATE) ───────────────────────────────────────
# Passcode used to enter the "Manage Memories" panel on the site.
# Defaults to "admin2410" if not set. Change to your own private passcode!
VITE_ADMIN_PASSCODE=your-secret-admin-passcode

# Credentials checked by the Netlify auth function. Keep these server-side.
GALLERY_USERNAME=your-gallery-username
GALLERY_PASSWORD=your-gallery-password

# ── API CONFIGURATION ───────────────────────────────────────────────────────
# Base URL for Netlify Functions (auto-detected in production)
VITE_API_BASE=/.netlify/functions

# ── IMPORTANT SECURITY NOTES ─────────────────────────────────────────────────
# ⚠️ Only variables prefixed with `VITE_` are sent to the browser.
# ⚠️ MONGODB_URI, CLOUDINARY credentials are server-side only (not exposed to browser).
# ⚠️ Database and Storage are secured via Netlify Functions (serverless backend).
# ⚠️ All administrative operations require ADMIN_PASSCODE authentication.
# ⚠️ The Netlify Functions layer ensures your database and storage are PRIVATE.
